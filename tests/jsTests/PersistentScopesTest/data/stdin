// A persisted value must survive many native call scopes and garbage
// collection, and each access must give the same object
var first = require('keep');
var ok = true;

for (var i = 0; i < 1000; i++) {
  var m = require('m' + (i % 3));
  if (m.name != 'm' + (i % 3)) ok = false;

  var garbage = [];
  for (var j = 0; j < 100; j++) garbage.push({i: i, j: j, s: 'x' + j});

  var k = require('keep');
  if (k !== first || k.name != 'keep' || k.list.length != 3 || k.f() != 42)
    ok = false;
}

print(ok ? 'ok' : 'FAILED', require('keep').name, require('keep').f(), '\n');
